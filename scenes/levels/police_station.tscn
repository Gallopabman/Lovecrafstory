[node name="Inspect" type="Area3D" parent="Inspectables" unique_id=1031888727]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14.4, 1.5, 27.3)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Carteles de \"se busca\". Las caras están todas raspadas con algo filoso.", "En uno, debajo de la raspadura, se lee: \"Ibáñez\".")
radius = 1.2

[node name="Inspect2" type="Area3D" parent="Inspectables" unique_id=1090362894]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 1, 26)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Una denuncia a medio tipear: \"La señora refiere que su hijo salió a la niebla y volvió con la voz cambiada\".", "El oficial dejó de escribir en la mitad de una palabra.")
radius = 1.1

[node name="Inspect3" type="Area3D" parent="Inspectables" unique_id=2024472073]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6.4, 1, 12.6)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Expedientes de 1979. Un cajón entero con la misma etiqueta: \"Imperio\".")
radius = 1.2

[node name="Inspect4" type="Area3D" parent="Inspectables" unique_id=1262927026]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 25.8, 1.2, 10)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Lockers de los agentes. El de \"Sosa, R.\" está abierto y vacío. Adentro, una foto de una mujer cantando.")
radius = 1.0

[node name="Inspect5" type="Area3D" parent="Inspectables" unique_id=1264693067]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 1.2, 8.8)
script = ExtResource("71_nmppp")
texts = PackedStringArray("La armería. Cadena, candado y un cartel escrito a mano: \"NO DARLES ARMAS A LOS QUE OYEN\".")
radius = 1.2

[node name="Inspect6" type="Area3D" parent="Inspectables" unique_id=1600746723]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, 1, 5.4)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Un patrullero con el motor abierto. Le sacaron la batería y la radio.", "En el asiento de atrás hay marcas de uñas en el tapizado, de adentro hacia afuera.")
radius = 1.6

[node name="Inspect7" type="Area3D" parent="Inspectables" unique_id=1732615162]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 36.9, 1, 13.5)
script = ExtResource("71_nmppp")
texts = PackedStringArray("El calabozo 2, el del relojero. La reja tiene el candado puesto.", "En el piso, un reloj de bolsillo parado a las tres y cuarto.")
radius = 1.2

[node name="Inspect8" type="Area3D" parent="Inspectables" unique_id=268680177]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 36.9, 1, 10.5)
script = ExtResource("71_nmppp")
texts = PackedStringArray("El calabozo 3 está cerrado. Adentro, alguien raspó la pared con las uñas hasta los ladrillos.")
radius = 1.2

[node name="Inspect9" type="Area3D" parent="Inspectables" unique_id=724198721]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7, 4.6, 29.8)
script = ExtResource("71_nmppp")
texts = PackedStringArray("El escritorio del comisario. Un expediente: \"Desaparición Elena M. de Sosa, 1979. Archivado\".", "Alguien lo desarchivó hace poco. Las hojas están húmedas.")
radius = 1.1

[node name="Inspect10" type="Area3D" parent="Inspectables" unique_id=129993224]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 22, 5, 31.2)
script = ExtResource("71_nmppp")
texts = PackedStringArray("El pizarrón del caso. En el centro, la foto de la soprano Elena M. de Sosa. Hilos rojos hacia todos lados:", "el Teatro Imperio, el relojero Kaufmann, la parroquia, el San Judas. Y una foto nueva, de esta semana: el agente Sosa.", "Alguien escribió con marcador: \"SE LO LLEVÓ LA MISMA CANCIÓN\".")
radius = 1.5

[node name="Inspect11" type="Area3D" parent="Inspectables" unique_id=134583143]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 33.6, 5, 27)
script = ExtResource("71_nmppp")
texts = PackedStringArray("Del otro lado del vidrio espejado hay una mesa y dos sillas. En una, alguien sentado de espaldas.", "Parpadeás y la silla está vacía. La grabadora de la mesa sigue andando.")
radius = 1.2

[node name="Inspect12" type="Area3D" parent="Inspectables" unique_id=691801234]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 39, 4.6, 2.2)
script = ExtResource("71_nmppp")
texts = PackedStringArray("El escritorio del agente Sosa. Un mapa de la avenida con la pensión marcada y el teatro tachado tres veces.", "En un post-it: \"Mamá. Fila 7, butaca 13. Ir solo.\"")
radius = 1.1

[node name="Inspect13" type="Area3D" parent="Inspectables" unique_id=1312291438]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 4.6, 1)
script = ExtResource("71_nmppp")
texts = PackedStringArray("La radio de la comisaría, en la frecuencia de emergencias. Entre la estática, una voz de mujer canta muy bajito.")
radius = 1.1

