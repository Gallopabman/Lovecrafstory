[node name="Inspect21" type="Area3D" parent="Inspectables" unique_id=1944397576]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 91.5, 2.3, 24.2)
script = ExtResource("66_87umf")
texts = PackedStringArray("El espejo del camarín. Tu reflejo tarda un instante de más en moverse.")
