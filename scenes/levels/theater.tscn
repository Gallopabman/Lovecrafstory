texts = PackedStringArray("El talonario de entradas. La última vendida: fila 7, butaca 13. Fecha: hoy.", "Todas las demás entradas del talonario están cortadas. Nadie las vendió. Están todas ocupadas.")
radius = 1.1

[node name="Inspect2" type="Area3D" parent="Inspectables" unique_id=559171358]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18.9, 1.3, -1)
script = ExtResource("66_87umf")
texts = PackedStringArray("Cientos de fichas del guardarropa colgadas en su tablero. Ningún abrigo.", "Una sola percha tiene algo: un tapado verde, igual al de la pensión.")
radius = 1.2

[node name="Inspect3" type="Area3D" parent="Inspectables" unique_id=759923204]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 8, 0.8, 27)
