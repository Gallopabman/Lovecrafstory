[node name="Inspect4" type="Area3D" parent="Inspectables" unique_id=1892879922]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 1.6, -23.2)
script = ExtResource("66_87umf")
texts = PackedStringArray("El salón de los espejos. En todos, el salón está lleno de gente de gala, esperando.", "Del lado de acá no hay nadie.")
radius = 1.6

[node name="Inspect5" type="Area3D" parent="Inspectables" unique_id=1108258153]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14, 1.6, 39.4)
script = ExtResource("66_87umf")
texts = PackedStringArray("Retratos de los artistas del Imperio. El del medio está vacío: queda el marco y una plaquita.", "\"Elena M. de Sosa, soprano. 1979\".")
radius = 1.4

[node name="Inspect6" type="Area3D" parent="Inspectables" unique_id=1857323486]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 1.2, 30.6)
script = ExtResource("66_87umf")
texts = PackedStringArray("En la barra hay una copa de champán con marca de rouge, todavía con burbujas.")
radius = 1.2

[node name="Inspect7" type="Area3D" parent="Inspectables" unique_id=649556445]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 6, -9)
script = ExtResource("66_87umf")
texts = PackedStringArray("El archivo de la administración. Programas, contratos, planillas de recaudación.", "La planilla de la función del 14 de marzo de 1979 dice: \"Localidades vendidas: 1. Recaudación: 0\".")
radius = 1.4

[node name="Inspect8" type="Area3D" parent="Inspectables" unique_id=1936128287]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5, 6, -21.6)
script = ExtResource("66_87umf")
texts = PackedStringArray("El escritorio del director. Una carta sin enviar, a la policía: \"No sé cómo explicarlo. Ella sigue en el teatro.\"", "Fechada en abril de 1979. Abajo, otra fecha, de este año, con la misma letra temblorosa: \"Sigue\".")
radius = 1.2

[node name="Inspect9" type="Area3D" parent="Inspectables" unique_id=2086127051]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 34, 1.2, -22.8)
script = ExtResource("66_87umf")
texts = PackedStringArray("Un piano vertical con la tapa cerrada con llave. Adentro, alguien practica escalas, muy despacio.")
radius = 1.2

[node name="Inspect10" type="Area3D" parent="Inspectables" unique_id=1035113288]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 52, 1.3, -23)
script = ExtResource("66_87umf")
texts = PackedStringArray("La escuela de danza. En los espejos hay marcas de manos a la altura de la barra. De este lado no hay ninguna.")
radius = 1.4

[node name="Inspect11" type="Area3D" parent="Inspectables" unique_id=1226922924]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 34.2, 1.2, 34.4)
script = ExtResource("66_87umf")
texts = PackedStringArray("El museo del teatro. En una vitrina, el vestido de gala de \"La Paloma\". Está húmedo, como recién usado.")
radius = 1.3

[node name="Inspect12" type="Area3D" parent="Inspectables" unique_id=1990170747]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 64, 1.2, 38.8)
script = ExtResource("66_87umf")
texts = PackedStringArray("Partituras. Todas de \"La Paloma\", en todas las tonalidades posibles. Algunas en tonalidades que no existen.")
radius = 1.3

[node name="Inspect13" type="Area3D" parent="Inspectables" unique_id=1686715360]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 36.9, 0.8, 3.5)
script = ExtResource("66_87umf")
texts = PackedStringArray("Fila 7, butaca 13. Está tibia. El resto de la sala está helada.")
radius = 1.2

[node name="Inspect14" type="Area3D" parent="Inspectables" unique_id=291287525]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30, 6, 8)
script = ExtResource("66_87umf")
texts = PackedStringArray("El pullman. Desde acá se ve todo el escenario. Y la butaca 13 de la fila 7, iluminada aunque no haya luz.")
radius = 1.4

[node name="Inspect15" type="Area3D" parent="Inspectables" unique_id=1634115866]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 65.1, 2.1, 2.5)
script = ExtResource("66_87umf")
texts = PackedStringArray("Las teclas están tibias. En el atril, la partitura de \"La Paloma\".", "Alguien anotó en rojo sobre el pentagrama: otra vez, otra vez, otra vez.")
radius = 1.3

[node name="Inspect16" type="Area3D" parent="Inspectables" unique_id=471067551]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 70, 2.1, 13)
script = ExtResource("66_87umf")
texts = PackedStringArray("La luz fantasma. Dicen que se deja prendida para que los fantasmas puedan actuar cuando no hay nadie.", "La lamparita es nueva.")
radius = 1.1

[node name="Inspect17" type="Area3D" parent="Inspectables" unique_id=781407259]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 78.5, 2.1, 27.4)
script = ExtResource("66_87umf")
texts = PackedStringArray("Una escalera de servicio baja al foso de máquinas. De abajo sube aire tibio y olor a polvo de telón.")
radius = 1.2

[node name="Inspect18" type="Area3D" parent="Inspectables" unique_id=1522054486]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 92, 2.1, -22.4)
script = ExtResource("66_87umf")
texts = PackedStringArray("El taller. Una escenografía a medio pintar: la fachada del Hospital San Judas, con todas las ventanas iluminadas.")
radius = 1.2

[node name="Inspect19" type="Area3D" parent="Inspectables" unique_id=769734480]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 93, 2.1, 16)
script = ExtResource("66_87umf")
texts = PackedStringArray("Cabezas de utilería en un estante. Una tiene la cara de alguien que conocés.")
