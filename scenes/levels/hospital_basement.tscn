[node name="Inspect" type="Area3D" parent="Inspectables" unique_id=887360462]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5, 1.2, 1.5)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Las paredes de la escalera tienen marcas de manos. Muchas. Todas hacia arriba.")
radius = 1.0

[node name="Inspect2" type="Area3D" parent="Inspectables" unique_id=1114063137]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 13.5, 1.2, 3.8)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Una de las calderas está encendida. Nadie la alimenta, y sin embargo sigue caliente.", "Por la mirilla se ve el fuego. Adentro hay algo que no es carbón.")
radius = 1.2

[node name="Inspect3" type="Area3D" parent="Inspectables" unique_id=586013541]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 24, 1.3, 4.8)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Sábanas colgadas a secar. Una tiene la forma de alguien, en manchas, como el sudario de una estampita.")
radius = 1.3

[node name="Inspect4" type="Area3D" parent="Inspectables" unique_id=586310323]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 38, 1.5, 3.6)
script = ExtResource("71_d5pew")
texts = PackedStringArray("El grupo electrógeno del hospital. Alguien le cortó los cables con una tenaza, prolijamente, uno por uno.")
radius = 1.4

[node name="Inspect5" type="Area3D" parent="Inspectables" unique_id=1410104602]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.4, 1.3, 14.9)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Las cámaras de la morgue. Una está abierta y la bandeja afuera. La bolsa está vacía y cortada desde adentro.", "Las otras tienen etiquetas con fecha: todas del día 10. Algunas se mueven si uno se queda quieto.")
radius = 1.4

[node name="Inspect6" type="Area3D" parent="Inspectables" unique_id=1346365042]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9, 1, 13)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Una bolsa con una etiqueta: \"N.N. - mujer - traída por la policía\". Pesa poco. Demasiado poco.")
radius = 1.2

[node name="Inspect7" type="Area3D" parent="Inspectables" unique_id=133534817]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19.5, 1.2, 18.5)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Sobre la mesa, un informe de autopsia sin terminar: \"Órganos en posición normal. Pero hay más.\"", "\"Un segundo corazón, pequeño, en la base del cráneo. Late.\"")
radius = 1.2

[node name="Inspect8" type="Area3D" parent="Inspectables" unique_id=839230162]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 6, 1, 26.4)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Cajas de historias clínicas de 1979. Una carpeta está fuera de lugar, encima de todo: \"Elena M. de Sosa\".", "Diagnóstico: \"Melancolía grave\". Alta voluntaria el 14 de marzo. Al lado, a mano: \"Va a cantar igual\".")
radius = 1.4

[node name="Inspect9" type="Area3D" parent="Inspectables" unique_id=2136407797]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19.5, 1.1, 29.6)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Las velas están recién prendidas. Alguien sigue bajando a rezar.", "En el altar, un papel con una lista de nombres. El último, con letra apurada: \"Por los que bajamos vivos\".")
radius = 1.4

[node name="Inspect10" type="Area3D" parent="Inspectables" unique_id=750739011]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30.8, 1.2, 13.5)
script = ExtResource("71_d5pew")
texts = PackedStringArray("\"RESIDUOS PATOGÉNICOS\". Los tachos rebalsan. Algunas bolsas todavía están tibias.")
radius = 1.2

[node name="Inspect11" type="Area3D" parent="Inspectables" unique_id=1609958100]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 35.2, 1.4, 20)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Del otro lado de la puerta del incinerador se oye respirar. Muchas respiraciones, a destiempo.")
radius = 1.4

[node name="Inspect12" type="Area3D" parent="Inspectables" unique_id=1018445452]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 50.6, 1.2, 17)
script = ExtResource("71_d5pew")
texts = PackedStringArray("La boca del incinerador. Adentro no hay fuego: hay caras, apretadas, mirando para afuera.")
radius = 1.4

[node name="Inspect13" type="Area3D" parent="Inspectables" unique_id=2033433495]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 49, 1, 38.6)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Un puesto de guardia improvisado. Un termo, mate frío, planillas de control cada dos horas.", "La última planilla tiene una sola anotación: \"Ya no son pacientes. Pero me reconocen. Vuelvo arriba a buscar a Ferreyra.\"", "La firma está corrida. Empieza con una I.")
radius = 1.3

[node name="Inspect14" type="Area3D" parent="Inspectables" unique_id=193499864]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 54, 1, 38.6)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Sobre la almohada, un estetoscopio. Mamá tiene uno igual, con la goma mordida en el mismo lugar.")
radius = 1.2

[node name="Inspect15" type="Area3D" parent="Inspectables" unique_id=903913567]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23, 1.4, 35.8)
script = ExtResource("71_d5pew")
texts = PackedStringArray("Algo cuelga de un gancho, envuelto en film. Tiene el tamaño de un chico. No lo voy a abrir.")
radius = 1.2

[node name="Inspect16" type="Area3D" parent="Inspectables" unique_id=68137675]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 38, 1, 39)
script = ExtResource("71_d5pew")
texts = PackedStringArray("El banco del taller. Una soldadora, varillas de hierro y un plano del hospital con las ventanas marcadas en rojo.", "Acá se hicieron las rejas que Ferreyra mandó soldar.")
radius = 1.2

