[node name="HospitalDoor" type="Area3D" parent="Inspectables" unique_id=1688155224]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3, 1.2, 5)
script = ExtResource("70_n3j2h")
target_scene = "res://scenes/levels/hospital.tscn"
target_spawn = &"from_basement"
