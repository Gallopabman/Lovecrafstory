[node name="Inspect" type="Area3D" parent="Inspectables" unique_id=1359857831]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.6, 1, -5.4)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("El buzón de casa. Adentro, folletos del centro de día y una boleta de luz sin pagar.")

[node name="Inspect2" type="Area3D" parent="Inspectables" unique_id=273169906]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9, 2, -5.3)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Arriba, en la ventanita del ático, hay una luz. Mamá no dejaría nada prendido.")
radius = 1.2

[node name="Inspect3" type="Area3D" parent="Inspectables" unique_id=1407001079]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.2, 1, 0.5)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Un camión volcado de punta a punta. Detrás, la niebla es una pared.", "Se oye algo grande respirando del otro lado. No voy a pasar por acá.")
radius = 2.0

[node name="Inspect4" type="Area3D" parent="Inspectables" unique_id=1937403164]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28.2, 1, -60)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Se cayó la fachada entera del edificio de la esquina. Los escombros todavía están tibios.", "Entre los ladrillos asoma una mano. No la miro más.")
radius = 2.4

[node name="Inspect5" type="Area3D" parent="Inspectables" unique_id=972695213]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 163.8, 1, -60)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Un andamio caído y medio edificio encima. Por acá no se sale del barrio.")
radius = 2.4

[node name="Inspect6" type="Area3D" parent="Inspectables" unique_id=852024055]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 101.8, 1, 0)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("La calle se hundió entera. Abajo corre agua, y el ruido no es solo de agua.", "Para llegar al hospital voy a tener que dar la vuelta por Rondeau.")
radius = 2.5

[node name="Inspect7" type="Area3D" parent="Inspectables" unique_id=1667396998]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 115.2, 1, 0)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Del otro lado del pozo se ve la esquina de Moreno. Parece a un paso. No lo es.")
radius = 2.5

[node name="Inspect8" type="Area3D" parent="Inspectables" unique_id=673655354]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 73, 1.2, -89)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("El autoservicio está cerrado con una cadena. Por la vidriera se ven las góndolas vacías.", "Alguien escribió en el vidrio, con el dedo: \"NO QUEDA NADA\".")
radius = 1.8

[node name="Inspect9" type="Area3D" parent="Inspectables" unique_id=144874800]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 103.5, 1.2, -29.5)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Pasaje Ombú. No tendría que entrar acá.", "Doce meses sin pisarlo. Las piernas se acuerdan del camino solas.")
radius = 1.6

[node name="Inspect10" type="Area3D" parent="Inspectables" unique_id=870369837]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 126.4, 0.8, -28.9)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("La esquina del Flaco. El colchón, la frazada, el tacho para el fuego. Nadie se llevó nada.", "Acá dejé el sueldo de tres meses y la guitarra de papá. Y casi todo lo demás.", "No hay nadie. Igual tengo las manos transpiradas, como antes.")
radius = 1.6

[node name="Inspect11" type="Area3D" parent="Inspectables" unique_id=953397086]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 51.22, 1.2, -5.4)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("El Centro de Día. Martes y jueves, grupo a las seis. Yo me sentaba al lado de la ventana.", "En la vidriera sigue el cartel que pintamos entre todos: \"UN DÍA A LA VEZ\".", "La puerta tiene cadena. Del otro lado se oye una silla arrastrándose, despacio, en círculos.")
radius = 1.4

[node name="Inspect12" type="Area3D" parent="Inspectables" unique_id=1997087893]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 99.22, 1.2, -65.4)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("La farmacia de Don Aldo. Rompieron la vidriera y se llevaron todo, hasta los termómetros.", "Acá venía con recetas que no eran mías. Él sabía y me vendía igual, hasta que mamá vino a hablar con él.", "Después de eso me saludaba de lejos. Nunca supe si era vergüenza o lástima.")
radius = 1.4

[node name="HospitalDoor" type="Area3D" parent="Inspectables" unique_id=1054846600]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 202.8, 1.65, 0.5)
script = ExtResource("92_6x2vs")
target_scene = "res://scenes/levels/hospital.tscn"
target_spawn = &"from_park"
radius = 1.4

[node name="Inspect13" type="Area3D" parent="Inspectables" unique_id=1481749000]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 193.5, 1, -2.5)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Una ambulancia del San Judas, con las puertas de atrás abiertas.", "Adentro, una camilla vacía y un estetoscopio. En el piso, un gafete: \"Dra. M. Ibáñez\". Mamá.")
radius = 2.4

[node name="Inspect14" type="Area3D" parent="Inspectables" unique_id=1670005605]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 186, 1, 12)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Una carpa de triage. Tres camillas, una con una bolsa negra cerrada.", "En la lona alguien anotó nombres con fibra. El último está a medio escribir: \"Ib\".")
radius = 2.2

[node name="Inspect15" type="Area3D" parent="Inspectables" unique_id=845750210]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 183, 1, -7.4)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("La garita del guardia. La radio está prendida, solo ruido.", "En el libro de ingresos, la última línea: \"03:15 - entra una ambulancia sin chofer\".")
radius = 1.6

[node name="Inspect18" type="Area3D" parent="Inspectables" unique_id=688755344]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14, 1, 2.2)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("El auto de un vecino, con las llaves puestas y el motor frío. Nunca lo dejaba en la calle.")
radius = 2.0

[node name="Inspect19" type="Area3D" parent="Inspectables" unique_id=866326980]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 96, 1, 8.8)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Un bloqueo de la policía: patrulleros cruzados de vereda a vereda y cinta de \"NO PASAR\".", "Del otro lado la calle sigue hacia el Parque Centenario. Entre los árboles se mueve algo alto, despacio.", "Los patrulleros están vacíos. En la radio de uno, alguien repite un código que no conozco.")
radius = 2.6

[node name="Inspect20" type="Area3D" parent="Inspectables" unique_id=856547784]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 90.4, 1.2, -5.1)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Un cartel pegado con cinta en el poste: \"NARCÓTICOS ANÓNIMOS. Jueves 20 h, salón de la Parroquia San Judas Tadeo. Sólo por hoy.\"", "Lo pegué yo, hace dos meses. Era mi tarea de servicio. Está casi despegado.")
radius = 1.2

[node name="Inspect21" type="Area3D" parent="Inspectables" unique_id=437883919]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 20, 1, 4.6)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("El banco de la plaza. Acá me sentaba a esperar que se hiciera de noche para ir al pasaje.", "Después me sentaba acá a esperar que se me pasaran las ganas. Las dos cosas llevaban más o menos lo mismo.")
radius = 1.2

[node name="Inspect22" type="Area3D" parent="Inspectables" unique_id=1056088706]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 155.2, 1, -12)
script = ExtResource("94_0xsdn")
texts = PackedStringArray("Una pintada en la persiana: \"EL BARRIO NO OLVIDA\". Abajo, con otra letra: \"Pero perdona\".")
radius = 1.4

