[node name="Inspect6" type="Area3D" parent="Inspectables" unique_id=1714457339]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 13, 1, 1)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Estantes saqueados. Quedan frascos de un antipsicótico vencido y, escondidas atrás, golosinas de la máquina.")
radius = 0.9

[node name="Inspect7" type="Area3D" parent="Inspectables" unique_id=725883258]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 21, 1, 2)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Una receta a medio escribir: \"Reposo. Evitar la niebla. No mirar a los...\". La tinta se corrió.")
radius = 0.9

[node name="Inspect8" type="Area3D" parent="Inspectables" unique_id=488800580]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 1, 16.4)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Los monitores de las cámaras. Pasillos vacíos. En uno, alguien parado en el quirófano de arriba. Parpadeás y ya no está.")
radius = 0.9

[node name="Inspect9" type="Area3D" parent="Inspectables" unique_id=1063771640]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 15.5, 1.2, 19.3)
script = ExtResource("89_b4xam")
texts = PackedStringArray("La entrada principal. Cadenas gruesas, un candado del lado de afuera, y una barricada del de adentro.", "Alguien no quería que saliéramos. O que algo entrara.")
radius = 0.9

[node name="Inspect10" type="Area3D" parent="Inspectables" unique_id=226716500]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10, 1.1, 13.2)
script = ExtResource("89_b4xam")
texts = PackedStringArray("El libro de ingresos. Última entrada: \"Mujer trae a su hija. Dice que la niebla le habló. Sala 2.\" Después, hojas arrancadas.")
radius = 0.9

[node name="Inspect11" type="Area3D" parent="Inspectables" unique_id=1529898152]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23.4, 1.4, 16)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Estática. Por un segundo jurarías que alguien te mira desde la pantalla.")
radius = 0.9

[node name="Inspect12" type="Area3D" parent="Inspectables" unique_id=1717178127]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 21, 1.6, 19.6)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Rejas soldadas desde adentro. Del otro lado, solo niebla.")
radius = 0.9

[node name="Inspect13" type="Area3D" parent="Inspectables" unique_id=1952748934]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 35.4, 1.4, 13.1)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Tu reflejo tarda un instante en seguirte.")
radius = 0.9

[node name="Inspect14" type="Area3D" parent="Inspectables" unique_id=2045243411]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7.5, 1.2, 8.4)
script = ExtResource("89_b4xam")
texts = PackedStringArray("El ascensor está muerto. Las puertas no ceden ni un centímetro.")
radius = 0.9

[node name="Inspect15" type="Area3D" parent="Inspectables" unique_id=1979669349]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 35.6, 1.2, 9.5)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Salida de emergencia. Trabada con algo pesado del otro lado.", "Del otro lado se oye la calle. Motores que no arrancan. Pasos que no son de nadie.")
radius = 0.9

[node name="Inspect16" type="Area3D" parent="Inspectables" unique_id=225862534]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.4, 1.6, 9.5)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Rejas soldadas. La niebla se pega al vidrio como si quisiera entrar.")
radius = 0.9

[node name="Inspect17" type="Area3D" parent="Inspectables" unique_id=1412836938]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, 4.2, 1.5)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Cama 4. Las correas están cortadas. Desde adentro.")
radius = 0.9

[node name="Inspect18" type="Area3D" parent="Inspectables" unique_id=1566525704]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 11.5, 5.1, 0.4)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Rejas soldadas. Abajo, el estacionamiento se pierde en la niebla. Hay una ambulancia con las puertas abiertas.")
radius = 0.9

[node name="Inspect19" type="Area3D" parent="Inspectables" unique_id=1980450633]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30, 4.6, 4)
script = ExtResource("89_b4xam")
texts = PackedStringArray("Instrumental sin limpiar sobre la mesa. Nadie terminó esta operación.")
