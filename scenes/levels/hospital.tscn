script = ExtResource("95_qk5d2")
texts = PackedStringArray("Historias clínicas. Todas terminan el mismo día.")
radius = 0.9

[node name="Inspect21" type="Area3D" parent="Inspectables" unique_id=1300107858]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7.5, 4.7, 8.4)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Donde estaba el ascensor ahora hay una escalera de servicio. La cabina quedó trabada abajo, en PB.", "Alguien atornilló un cartel a mano: \"SALUD MENTAL - 2° PISO\".")
radius = 0.9

[node name="Inspect22" type="Area3D" parent="Inspectables" unique_id=1306510244]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.6, 8.4, 4)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Un afiche: \"PEDIR AYUDA NO ES DEBILIDAD\". Debajo, el número de la línea de prevención, tachado con birome hasta romper el papel.")
radius = 0.9

[node name="Inspect23" type="Area3D" parent="Inspectables" unique_id=1680632135]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 10.5, 7.8, 1.3)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Las sábanas están atadas en una soga larga. No llega a ningún lado: la ventana tiene rejas.")
radius = 0.9

[node name="Inspect24" type="Area3D" parent="Inspectables" unique_id=1471367128]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16.9, 7.8, 1.3)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("La 203. Acá estuve cuarenta y cinco días, hace dos años, cuando mamá me encontró en el baño.", "En la tablilla de los pies de la cama todavía hay una planilla: \"Episodio depresivo mayor. Consumo problemático. Riesgo: alto.\"", "Abajo, con la letra de mamá: \"Alta. Ya está. Vamos a casa.\"")
radius = 1.1

[node name="Inspect25" type="Area3D" parent="Inspectables" unique_id=686419620]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 15.4, 8.4, 7.6)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Las marcas en la pared, al lado de la puerta. Rayitas de a cinco. Las hice yo, con la uña. Cuarenta y cinco.")
radius = 0.9

[node name="Inspect26" type="Area3D" parent="Inspectables" unique_id=1124464851]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19.5, 7.6, 2)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("La sala de aislamiento. Las paredes acolchadas están rasguñadas desde adentro, a la altura de la cara.")
radius = 0.9

[node name="Inspect27" type="Area3D" parent="Inspectables" unique_id=1820788564]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 24, 7.9, 4)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Ocho sillas en ronda. Una está dada vuelta, mirando a la pared.", "En el grupo había una regla: lo que se dice acá, se queda acá. Ahora no queda nadie para escuchar.")
radius = 1.4

[node name="Inspect28" type="Area3D" parent="Inspectables" unique_id=256354481]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 29, 8, 2.5)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Un rompecabezas de mil piezas a medio armar: un faro en la costa. Faltan las piezas del cielo.")
radius = 0.9

[node name="Inspect29" type="Area3D" parent="Inspectables" unique_id=2019076148]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 8, 17.8)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Sobre el escritorio hay una carpeta con mi nombre, abierta en la última sesión.", "\"Refiere mejoría. Duerme mejor. Habla de la madre con menos culpa. Continuar seguimiento ambulatorio.\"", "Continuar. Me gusta esa palabra.")
radius = 1.1

[node name="Inspect30" type="Area3D" parent="Inspectables" unique_id=1590942627]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 14.6, 8.2, 19)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("El armario de los psicofármacos. \"BAJO LLAVE\", dice el cartel. Está abierto y vacío.", "Lo primero que alguien vino a buscar cuando empezó la niebla. Lo entiendo mejor de lo que quisiera.")
radius = 1.1

[node name="Inspect31" type="Area3D" parent="Inspectables" unique_id=1169355873]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 19, 8, 13.6)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Historias clínicas de Salud Mental. Las del último mes dicen todas lo mismo, con distintas letras:", "\"El paciente refiere que la niebla le habla con la voz de alguien que perdió.\"")
radius = 0.9

[node name="Inspect32" type="Area3D" parent="Inspectables" unique_id=1909901964]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 31, 8.2, 18.6)
script = ExtResource("95_qk5d2")
texts = PackedStringArray("Una de las duchas está abierta. No sale agua: sale niebla, tibia, despacio.")
radius = 0.9

