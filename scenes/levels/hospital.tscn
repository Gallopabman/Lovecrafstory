[node name="Inspect20" type="Area3D" parent="Inspectables" unique_id=1052159635]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 4.5, 17.3)
script = ExtResource("89_b4xam")
texts = PackedStringArray("El teléfono no tiene tono. Aun así, del otro lado alguien respira.")
