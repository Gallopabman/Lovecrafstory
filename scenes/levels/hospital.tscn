[node name="Inspect17" type="Area3D" parent="Inspectables" unique_id=1099035054]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30, 4.6, 4)
script = ExtResource("91_kxgfw")
texts = PackedStringArray("Instrumental sin limpiar sobre la mesa. Nadie terminó esta operación.")
