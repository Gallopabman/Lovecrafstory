[resource]
script = ExtResource("1_item")
id = &"letter_ferreyra_02"
display_name = "Diario de Ferreyra"
short_name = "CARTA"
description = "Una libreta de tapas negras, abierta sobre el escritorio. La letra empieza prolija y termina temblando."
kind = 3
max_sanity_bonus = 15.0
letter_text = "Día 10. Los primeros, los que decían que la niebla les hablaba, empezaron a cambiar. No se mueren. Cambian. Los bajamos a la morgue, al sótano, con los que ya no respiraban. Pensé que el frío los iba a calmar.

Día 11. La Dra. Ibáñez quiere bajar. Dice que siguen siendo pacientes. Le dije que se fuera a su casa con su hijo. Me miró como se mira a un cobarde. Tenía razón.

Día 12. Abajo, en la sala del incinerador, se están juntando. Se oyen a través del piso de la guardia. Uno solo, muy grande, hecho de muchos. Me llama \"doctor\". Me llama por mi nombre de chico.

Cerré el sótano con la llave nueva. Es la única copia. Quise tirarla a la niebla y no pude. Me la traje a casa, como si fuera un pariente enfermo.

Si alguien la encuentra: no baje. Y si baja, porque ya sé que va a bajar, no le conteste cuando le hable. Miente con la voz de los que uno quiere."
world_color = Color(0.92, 0.9, 0.82, 1)
world_scene = ExtResource("2_note")
world_size = 0.24
world_tint = Color(0.35, 0.33, 0.32, 1)
