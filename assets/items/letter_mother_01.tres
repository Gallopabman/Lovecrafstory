[ext_resource type="PackedScene" path="res://assets/models/items/letter_envelope.glb" id="2_env"]

[resource]
script = ExtResource("1_item")
id = &"letter_mother_01"
display_name = "Nota de mamá"
short_name = "NOTA"
description = "Pegada en la heladera con un imán de farmacia. La letra apurada de siempre, la de las recetas."
kind = 3
letter_text = "Hijo:\n\nMe llamaron del San Judas. Dicen que la niebla está enfermando a la gente y necesitan a todos los médicos. No salgas de casa.\n\nHay comida en la alacena y en la heladera. Tomá la medicación de la mañana, la de la cajita azul, nada más.\n\nEl ático lo cerré yo. No es que no confíe en vos. Es que no confío en lo que la tristeza te dice de noche.\n\nSi no vuelvo hoy, no me vengas a buscar. Te lo pido por favor.\n\nTe quiero.\n\nMamá"
world_color = Color(0.92, 0.9, 0.82, 1)
world_scene = ExtResource("2_env")
world_size = 0.26
world_rotation = Vector3(-90, 0, 0)
