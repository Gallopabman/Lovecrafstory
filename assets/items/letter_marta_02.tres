[resource]
script = ExtResource("1_item")
id = &"letter_marta_02"
display_name = "Segunda carta de Marta"
short_name = "CARTA"
description = "Metida en un ladrillo flojo del patio. El papel huele a humo."
kind = 3
letter_text = "Salí del San Judas por la puerta de atrás. Tuve que forzarla; el doctor la había trabado desde adentro.

La calle está peor. Los autos quedaron donde los dejaron, con las puertas abiertas, como si todos hubieran bajado a mirar algo al mismo tiempo.

Al fondo está el Imperio. Las luces de la marquesina siguen prendidas y no hay electricidad en ninguna otra parte. Anoche alguien tocaba el piano adentro. La misma melodía, una y otra vez, como si esperara que alguien la reconozca.

Yo la reconocí. Me la cantaba mi mamá.

No voy a entrar. Todavía no.

- M."
world_color = Color(0.9, 0.88, 0.8, 1)
world_scene = ExtResource("2_sww5n")
world_size = 0.26
world_rotation = Vector3(-90, 0, 0)
world_tint = Color(0.95, 0.9, 0.8, 1)
