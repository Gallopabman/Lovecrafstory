[gd_resource type="Resource" script_class="ItemData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"letter_marta_03"
display_name = "Última carta de Marta"
short_name = "CARTA"
description = "Doblada adentro de una polvera, en el tocador del camarín principal."
kind = 3
max_sanity_bonus = 15.0
letter_text = "Entré.\n\nElla estaba en el escenario, cantando \"La Paloma\" para una sala llena de gente que no tenía cara. Cuando terminó, aplaudieron sin manos.\n\nNo era mi mamá. Era lo que quedó de todas las mamás que alguien extrañó en esta niebla. Se viste con lo que recordamos. Por eso cada uno la ve distinta.\n\nMe escondí acá, en su camarín. Es raro: es el lugar más tranquilo que encontré desde el día uno. Como si ella también necesitara un lugar donde no cantar.\n\nSi la callaste, este cuarto es tuyo. Prendé las luces del espejo. Poné flores, aunque sean de papel.\n\nY si alguna vez escuchás la melodía otra vez, no cantes.\n\n- Marta"
world_color = Color(0.9, 0.88, 0.8, 1)
