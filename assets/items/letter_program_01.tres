script = ExtResource("1_item")
id = &"letter_program_01"
display_name = "Programa de mano (1979)"
short_name = "PROG"
description = "Un programa de papel ilustración, amarillento, en una sala de ensayo que no figura en los planos."
kind = 3
letter_text = "TEATRO IMPERIO - Temporada 1979

GALA LÍRICA
\"La Paloma\" (S. Iradier)
Soprano: Elena M. de Sosa
Al piano: Maestro A. Kaufmann

Función única. Tres y cuarto de la tarde.

(Escrito a mano, en el margen:)
\"Elena no salió a saludar. El telón bajó y ella siguió cantando detrás, horas, hasta que se le fue la voz. Después, el silencio. Nadie la volvió a ver. El maestro dice que todavía la escucha afinar.\""
