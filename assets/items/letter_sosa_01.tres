[ext_resource type="PackedScene" path="res://assets/models/items/letter_notebook.glb" id="2_vwtda"]

[resource]
script = ExtResource("1_item")
id = &"letter_sosa_01"
display_name = "Cuaderno del agente Sosa"
short_name = "CUAD"
description = "Un cuaderno de tapas duras en la mesa de luz de la pensión. Las últimas páginas están escritas apretado, sin márgenes."
kind = 3
letter_text = "Hoy volvió mamá.

No me asusté. Eso es lo que más me asusta: que no me asusté. Estaba en la vereda de la pensión, con el tapado verde que le compré en el '78, y me dijo que la función empezaba a las tres y cuarto, que no llegara tarde como siempre.

Ríos dice que no es ella. Ríos no la conoció.

El relojero de la esquina me paró todos los relojes a esa hora. \"Así no te perdés la función, pibe\", me dijo, y se rió con una boca que no era la suya.

Si alguien lee esto: la marquesina del Imperio no se apaga porque adentro alguien la necesita prendida. Para que la encontremos.

Ya es casi la hora.

- R. Sosa"
world_color = Color(0.55, 0.45, 0.35, 1)
world_scene = ExtResource("2_vwtda")
world_size = 0.28
world_tint = Color(0.7, 0.55, 0.4, 1)
