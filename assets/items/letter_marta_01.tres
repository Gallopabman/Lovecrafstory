[resource]
script = ExtResource("1_item")
id = &"letter_marta_01"
display_name = "Carta de Marta"
short_name = "CARTA"
description = "Un sobre arrugado, escondido donde nadie cuerdo miraría."
kind = 3
letter_text = "A quien encuentre esto:

Llevo once días en este edificio. La niebla no se levanta nunca, pero aprendí a leerla: cuando se cierra, es que algo se acerca, o que yo me estoy yendo.

Las paredes mienten. Cuando ya no das más, se abren. No sé si es un regalo o una trampa.

Comé algo. Leé algo. Acordate de quién eras.

Si me ves ahí afuera y ya no parezco yo, no me esperes.

- M."
world_color = Color(0.9, 0.88, 0.8, 1)
world_scene = ExtResource("2_xi166")
world_size = 0.26
world_rotation = Vector3(-90, 0, 0)
